<main class="catalog"><small>BÚSQUEDA</small><h1>Resultados</h1><form action="{{ routes.search_url }}"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Buscar prendas"><button>Buscar</button></form><div class="product-grid">{% for product in search.results %}{% if product.object_type == 'product' %}<article class="product-card">{% assign card_url = product.url %}{% if product.handle contains 'pm-os-06' %}{% assign card_url = '/products/pm-os-06-hodie-acid' %}{% endif %}<a href="{{ card_url }}"><div class="product-image">{% if product.handle contains 'pm-os-06' %}<img src="https://1101kw-m7.myshopify.com/cdn/shop/files/ImagendeChatGPT5oct2026_18_20_40.png?v=1791242059&width=900" loading="lazy" alt="{{ product.title }}">{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}{% else %}<span>ART³</span>{% endif %}</div><h3>{{ product.title }}</h3><div class="product-meta"><span>{{ product.price | money }}</span></div></a></article>{% endif %}{% endfor %}</div></main>
