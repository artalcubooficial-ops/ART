escape }}" data-image-source="{{ image.src | escape }}" href="#product-image-{{ forloop.index }}" aria-label="Ir a imagen {{ forloop.index }}"><img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy"></a>{% endif %}{% endfor %}</div>{% endif %}
  </div>
      <div class="product-info"><small>{{ product.type }}</small><h1>{{ product.title }}</h1><p class="price">{{ product.selected_or_first_available_variant.price | money }}</p><div class="product-description">{{ product.description }}</div>{% if product.handle == 'pm-os-04-boxy-fit' or product.handle == 'boxy-fit-pm-os-04' %}<nav class="art-color-links" aria-label="Elegir color" style="display:flex;gap:10px;flex-wrap:wrap;margin:18px 0"><a href="/products/boxy-fit-pm-os-04-beige" style="padding:8px 12px;border:1px solid #aaa;text-decoration:none;color:inherit">Beige</a><a href="/products/boxy-fit-pm-os-04-marfil" style="padding:8px 12px;border:1px solid #aaa;text-decoration:none;color:inherit">Marfil</a><a href="/products/boxy-fit-pm-os-04-negro" style="padding:8px 12px;border:1px solid #aaa;text-decoration:none;color:inherit">Negro</a></nav>{% elsif product.handle == 'pm-os-06-hodie-acid' %}<nav class="art-color-links" aria-label="Elegir color" style="display:flex;gap:10px;flex-wrap:wrap;margin:18px 0"><a href="/products/pm-os-06-negro-acid-wash-1" data-color-value="Negro Acid Wash" style="padding:8px 12px;border:1px solid #aaa;text-decoration:none;color:inherit">Negro Acid Wash</a><a href="/products/pm-os-06-azul-petroleo" data-color-value="Azul Petróleo" style="padding:8px 12px;border:1px solid #aaa;text-decoration:none;color:inherit">Azul Petróleo</a><a href="/products/pm-os-06-gris" data-color-value="Gris" style="padding:8px 12px;border:1px solid #aaa;text-decoration:none;color:inherit">Gris</a></nav>{% endif %}<form method="post" action="{{ routes.cart_add_url }}"><label for="product-color">Color</label><select id="product-color" data-option-index="0">{% assign color_values = '' %}{% for variant in product.variants %}{% unless color_values contains variant.option1 %}<option value="{{ variant.option1 | escape }}">{{ variant.option1 }}</option>{% assign color_values = color_values | append: variant.option1 | append: '|' %}{% endunless %}{% endfor %}</select><label for="product-size">Talla</label><select id="product-size" data-option-index="1">{% assign size_values = '' %}{% for variant in product.variants %}{% unless size_values contains variant.option2 %}<option value="{{ variant.option2 | escape }}">{{ variant.option2 }}</option>{% assign size_values = size_values | append: variant.option2 | append: '|' %}{% endunless %}{% endfor %}</select><input type="hidden" id="variant" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button type="submit"{% unless product.available %} disabled{% endunless %}>Añadir al carrito</button></form><details><summary>Envíos y cambios</summary><p>Consulta las condiciones vigentes de ART³ antes de comprar.</p></details><details><summary>Guía de tallas</summary><p>Selecciona la referencia y revisa la guía correspondiente antes de confirmar.</p></details></div>
</main>
<script>
  (() => {
    const colorSelect = document.querySelector('#product-color');
