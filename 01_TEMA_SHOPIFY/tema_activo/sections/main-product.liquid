      'pm-os-12': {title:'Tank acid wash', gramaje:'240 g', rows:[['S','52','—','70','19'],['M','54','—','72','19,5'],['L','56','—','73','20'],['XL','58','—','75','20,5']]},
      'pm-os-13': {title:'Crop top acid wash', gramaje:'240 g', rows:[['S','43','21','37','17'],['M','45','22','39','17,5'],['L','47','23','41','18'],['XL','51','24','43','18,5']]},
      'pm-os-14': {title:'Buzo', gramaje:'300 g', rows:[['S','41','58','58','11'],['M','43','60','60','12'],['L','45','62','62','13'],['XL','47','64','64','14']]},
      'pm-os-17': {title:'Camiseta gramaje alto', gramaje:'180 g', rows:[['S','34','23','48','10'],['M','35','24','49','11'],['L','36','25','50','12'],['XL','37','26','51','13']]},
      'pm-os-18': {title:'Qatar fit', gramaje:'250 g', rows:[['S','48','26','62','19'],['M','50','27','64','20'],['L','52','28','66','21'],['XL','54','29','68','22']]},
      'pm-os-19': {title:'Peruana', gramaje:'250 g', rows:[['S','50','28','65','21'],['M','52','29','67','22'],['L','54','30','69','23'],['XL','56','31','71','24']]}
    };
