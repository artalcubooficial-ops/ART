      'pm-os-08': {title:'Crop top', gramaje:'230 g', rows:[['S','45,5','21','42','14,5'],['M','47,5','22','44','15'],['L','49,5','23','46','15,5'],['XL','51,5','24','48','16']]},
      'pm-os-09': {title:'Crop top', gramaje:'260 g', rows:[['S','43','21','37','17'],['M','45','22','39','17,5'],['L','47','23','41','18'],['XL','51','24','43','18,5']]},
      'pm-os-10': {title:'Line', gramaje:'270 g', rows:[['S','49','19','70','19'],['M','51','20','72','19,5'],['L','53','21','74','20'],['XL','55','22','76','20,5']]},
