      document.querySelectorAll('.product-info .art-color-links a').forEach(link => {
        if (link.textContent.trim().toLowerCase() === 'negro') link.setAttribute('href', '/products/pm-os-05-negro?color=negro');
      });
    }
    const pm03HandleFixes = {'/products/pm-os-03-azl-claro':'/products/pm-os-03-azul-claro','/products/pm-os-03-maril':'/products/pm-os-03-marfil','/products/pm-os-07-drazno':'/products/pm-os-07-durazno-1','/products/pm-os-09-maril':'/products/pm-os-09-marfil'};
    document.querySelectorAll('.product-info .art-color-links a').forEach(link => { const fixed = pm03HandleFixes[link.getAttribute('href')]; if (fixed) link.setAttribute('href', fixed); });
    if (genericCode === 'pm-os-02') {
      const details = [...document.querySelectorAll('.product-info details')];
