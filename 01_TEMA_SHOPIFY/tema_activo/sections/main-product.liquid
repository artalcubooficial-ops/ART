    const sizeGuides = {
      'pm-os-02': {title:'Camiseta', gramaje:'230 g', rows:[['S','41','24','69','14,5'],['M','43','25','71','15'],['L','45','26','73','15,5'],['XL','47','27','75','16']]},
      'pm-os-03': {title:'Esmerilada', gramaje:'300 g', rows:[['S','50,5','22,5','68,5','22'],['M','52,5','23,5','70,5','22,5'],['L','54,5','24,5','72,5','23'],['XL','56,5','25,5','74,5','23,5']]},
      'pm-os-05': {title:'Tank', gramaje:'260 g', rows:[['S','47','—','69','16,5'],['M','49','—','71','17'],['L','51','—','73','17,5'],['XL','53','—','75','18']]},
      'pm-os-06': {title:'Buzo acid wash', gramaje:'320 g', rows:[['S','41','56','58','11'],['M','43','58','60','12'],['L','45','60','62','13'],['XL','47','62','64','14']]},
