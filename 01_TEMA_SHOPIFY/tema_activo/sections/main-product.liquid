      const sizeGuide = [...document.querySelectorAll('.product-info details')].find(item => item.querySelector('summary')?.textContent.trim() === 'Guía de tallas');
      if (sizeGuide) {
        sizeGuide.innerHTML = `<summary>Guía de tallas ${code.toUpperCase()}</summary><div class="pm01-size-guide"><p><strong>${guide.title} · Gramaje ${guide.gramaje} · Código ${code.toUpperCase()}</strong></p><div class="pm01-size-table-wrap"><table><thead><tr><th>Talla</th><th>Ancho pecho</th><th>Longitud manga</th><th>Longitud frente</th><th>Hombro</th></tr></thead><tbody>${guide.rows.map(row => `<tr>${row.map(cell => `<td>${cell}</td>`).join('')}</tr>`).join('')}</tbody></table></div></div>`;
      }
    }
    const variants = {{ product.variants | json }};
    const normalize = value => (value || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const pm01ColorHandles = {TABACO:'oversize-pm-os-01-tabaco', NEGRO:'oversize-pm-os-01-negro', ROJO:'oversize-pm-os-01-rojo', BLANCO:'oversize-pm-os-01-blanco'};
    if (handle.startsWith('oversize-pm-os-01-')) {
      if (colorSelect && (colorSelect.options.length === 0 || (colorSelect.options.length === 1 && colorSelect.options[0].textContent.trim() === 'Default Title'))) { colorSelect.innerHTML = ''; ['Tabaco','Negro','Rojo','Blanco'].forEach(value => colorSelect.add(new Option(value, value))); }
      if (sizeSelect) { sizeSelect.innerHTML = ''; ['S','M','L','XL'].forEach(value => sizeSelect.add(new Option(value, value))); }
    }
    if ((handle.includes('pm-os-01') || handle.includes('pm-os-04') || handle.includes('boxy-fit-pm-os-04')) && !document.querySelector('.product-info .art-color-links')) {
      const nav = document.createElement('nav');
      nav.className = 'art-color-links';
      nav.setAttribute('aria-label', 'Elegir color');
      nav.innerHTML = handle.includes('pm-os-04') || handle.includes('boxy-fit-pm-os-04') ? '<a href="/products/boxy-fit-pm-os-04-beige" data-color-value="Beige">Beige</a><a href="/products/boxy-fit-pm-os-04-marfil" data-color-value="Marfil">Marfil</a><a href="/products/boxy-fit-pm-os-04-negro" data-color-value="Negro">Negro</a>' : '<a href="/products/oversize-pm-os-01-tabaco" data-color-value="Tabaco">Tabaco</a><a href="/products/oversize-pm-os-01-negro" data-color-value="Negro">Negro</a><a href="/products/oversize-pm-os-01-rojo" data-color-value="Rojo">Rojo</a><a href="/products/oversize-pm-os-01-blanco" data-color-value="Blanco">Blanco</a>';
      document.querySelector('.product-info .product-description')?.after(nav);
    }
    const genericColorSets = {
      'pm-os-02':['Camel','Negro'], 'pm-os-03':['Azul claro','Beige','Gris plomo','Marfil','Negro','Verde manzana'],
      'pm-os-05':['Beige','Blanco','Negro'], 'pm-os-06':['Negro Acid Wash','Azul Petróleo','Gris'], 'pm-os-07':['Durazno','Negro'],
      'pm-os-08':['Negro','Blanco'], 'pm-os-09':['Marfil','Negro'], 'pm-os-10':['Blanco','Verde botella','Rojo','Negro'],
      'pm-os-11':['Vino tinto Acid Wash','Negro Acid Wash','Gris Acid Wash','Azul claro Acid Wash','Azul rey Acid Wash'],
      'pm-os-12':['Gris Acid Wash','Negro Acid Wash'], 'pm-os-13':['Verde militar Acid Wash','Gris Acid Wash'],
