      if (sizeSelect) { sizeSelect.innerHTML = ''; ['S','M','L','XL'].forEach(value => sizeSelect.add(new Option(value, value))); }
    }
    const handle = {{ product.handle | json }};
    const pm01Descriptions = {
      'oversize-pm-os-01-negro': 'Camiseta oversize ART³ PM-OS-01 en color negro. Su silueta amplia y contemporánea ofrece comodidad, presencia y un estilo urbano fácil de combinar. Ideal para looks casuales y modernos.',
      'oversize-pm-os-01-tabaco': 'Camiseta oversize ART³ PM-OS-01 en tono tabaco. Un color cálido y elegante que aporta personalidad sin perder versatilidad. Su corte amplio garantiza comodidad y una apariencia moderna.',
      'oversize-pm-os-01-rojo': 'Camiseta oversize ART³ PM-OS-01 en color rojo. Su tono intenso convierte una prenda básica en el punto focal del outfit. Cómoda, llamativa y perfecta para un estilo urbano con actitud.',
      'oversize-pm-os-01-blanco': 'Camiseta oversize ART³ PM-OS-01 en color blanco. Una pieza esencial, limpia y versátil, diseñada para combinar fácilmente con cualquier estilo. Su corte amplio brinda comodidad y una estética contemporánea.'
    };
