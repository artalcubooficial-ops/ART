<main class="editorial-home">
  <div class="editorial-promo"><span>Pago seguro y fácil</span><span>Compra por encargo</span><span>Cambios fáciles</span><span>Envíos a todo Colombia</span></div>
  <section class="editorial-hero"><div class="editorial-image">{% if section.settings.hero_image %}{{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', alt: section.settings.hero_title }}{% else %}<span>SUBE AQUÍ LA FOTO PRINCIPAL</span>{% endif %}<div class="editorial-hero-copy"><small>{{ section.settings.hero_kicker }}</small><h1>{{ section.settings.hero_title }}</h1><a class="button" href="{{ routes.all_products_collection_url }}">Comprar ahora</a></div></div></section>
  <section class="editorial-categories"><div class="editorial-section-title"><h2>Encuentra tu estilo</h2></div><div class="editorial-category-grid">{% assign cats = 'HOMBRE|Mujer|Kids' | split: '|' %}{% assign imgs = 'men_image|women_image|kids_image' | split: '|' %}{% for cat in cats %}{% assign key = imgs[forloop.index0] %}<a href="{{ routes.all_products_collection_url }}?filter.p.tag={{ cat | upcase }}" class="editorial-category"><div>{% if section.settings[key] %}{{ section.settings[key] | image_url: width: 1200 | image_tag: loading: 'lazy', alt: cat }}{% else %}<span>SUBE FOTO<br>{{ cat | upcase }}</span>{% endif %}<strong>{{ cat }}</strong><em>Comprar ahora</em></div></a>{% endfor %}</div></section>
  <section class="editorial-style"><h2>¿Cuál es tu estilo?</h2><div class="editorial-style-grid"><a href="{{ routes.all_products_collection_url }}"><div>{% if section.settings.lisa_image %}{{ section.settings.lisa_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Prendas lisas' }}{% endif %}<span>Prendas lisas</span></div></a><a href="{{ routes.all_products_collection_url }}?filter.p.tag=ART"><div>{% if section.settings.art_image %}{{ section.settings.art_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Diseños ART³' }}{% endif %}<span>Diseños ART³</span></div></a><a href="/pages/personaliza-la-prenda"><div>{% if section.settings.custom_image %}{{ section.settings.custom_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Personalizados' }}{% endif %}<span>Personalizados</span></div></a><a href="/pages/personaliza-la-prenda"><div>{% if section.settings.groups_image %}{{ section.settings.groups_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Pedidos para grupos' }}{% endif %}<span>Pedidos para grupos</span></div></a></div></section>
</main>
{% schema %}{"name":"Inicio editorial","settings":[{"type":"image_picker","id":"hero_image","label":"Foto principal"},{"type":"text","id":"hero_kicker","label":"Texto pequeño","default":"ART³ / NUEVA COLECCIÓN"},{"type":"text","id":"hero_title","label":"Título principal","default":"VISTE LA ART."},{"type":"image_picker","id":"men_image","label":"Foto Hombre"},{"type":"image_picker","id":"women_image","label":"Foto Mujer"},{"type":"image_picker","id":"kids_image","label":"Foto Kids"},{"type":"image_picker","id":"lisa_image","label":"Foto Prendas lisas"},{"type":"image_picker","id":"art_image","label":"Foto Diseños ART³"},{"type":"image_picker","id":"custom_image","label":"Foto Personalizados"},{"type":"image_picker","id":"groups_image","label":"Foto Pedidos para grupos"}],"presets":[{"name":"Inicio editorial"}]}{% endschema %}
