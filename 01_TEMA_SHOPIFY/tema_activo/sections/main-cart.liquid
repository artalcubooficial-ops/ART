<main class="cart-page"><small>CARRITO</small><h1>Tu selección</h1>{% if cart.item_count == 0 %}<p>Tu carrito está vacío.</p><a class="button" href="{{ routes.all_products_collection_url }}">Ver catálogo</a>{% else %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-lines">{% for item in cart.items %}<div class="cart-line"><div>{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: alt: item.title }}{% endif %}</div><div><h3>{{ item.product.title }}</h3><p>{{ item.variant.option1 }} / {% if item.variant.option2 == '4.0' and item.product.handle contains 'pm-os-14' %}XL{% else %}{{ item.variant.option2 }}{% endif %}</p><p>{{ item.final_line_price | money }}</p><label>Cantidad <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></label><a class="cart-remove" href="{{ item.url_to_remove }}">Eliminar del carrito</a></div></div>{% endfor %}</div><p class="cart-total">Subtotal: {{ cart.total_price | money }}</p><button name="update">Actualizar carrito</button><button name="checkout" type="submit">Ir al checkout</button></form>{% endif %}</main>