<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="{{ page_description | default: shop.description | escape }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:description" content="{{ page_description | default: shop.description | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  {% if page_image %}<meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">{% endif %}
  <title>{{ page_title }}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {% if template.name == 'product' %}{{ product | structured_data }}{% endif %}
</head>
<body>
  <header class="site-header">
    <a class="logo" href="{{ routes.root_url }}">ART<span>³</span></a>
    <nav aria-label="Navegación principal"><a href="{{ routes.all_products_collection_url }}">Shop</a><a href="/pages/manifiesto">Manifiesto</a><a href="https://www.tiktok.com/@art.al.cubo" target="_blank" rel="noopener">TikTok</a><a href="https://www.instagram.com/artalcubooficial/" target="_blank" rel="noopener">Instagram</a></nav>
    <a class="cart-link" href="{{ routes.cart_url }}" aria-label="Carrito" data-cart-open>Carrito · <span data-cart-count>{{ cart.item_count }}</span></a>
  </header>
  {{ content_for_layout }}
  <aside class="cart-drawer" data-cart-drawer aria-label="Carrito de compras" aria-hidden="true">
    <div class="cart-drawer__backdrop" data-cart-close></div>
    <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title">
      <div class="cart-drawer__header"><h2 id="cart-drawer-title">Tu selección</h2><button type="button" data-cart-close aria-label="Cerrar carrito">×</button></div>
      <div class="cart-drawer__body" data-cart-body>
        {% if cart.item_count == 0 %}<p>Tu carrito está vacío.</p>{% else %}{% for item in cart.items %}<div class="cart-drawer__line"><span>{{ item.quantity }} × {{ item.product.title }} — {{ item.final_line_price | money }}</span></div>{% endfor %}<p><strong>Subtotal: {{ cart.total_price | money }}</strong></p>{% endif %}
      </div>
      <a class="button" href="{{ routes.cart_url }}">Ver carrito y checkout</a>
    </div>
  </aside>
  <script>
    (() => { const drawer = document.querySelector('[data-cart-drawer]'); if (!drawer) return; const open = () => { drawer.setAttribute('aria-hidden','false'); drawer.classList.add('is-open'); }; const close = () => { drawer.setAttribute('aria-hidden','true'); drawer.classList.remove('is-open'); }; document.querySelectorAll('[data-cart-open]').forEach(el => el.addEventListener('click', e => { e.preventDefault(); open(); })); drawer.querySelectorAll('[data-cart-close]').forEach(el => el.addEventListener('click', close)); document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); }); })();
  </script>
  <footer><strong>ART³</strong><span>ART al Cubo · Colombia</span></footer>
</body>
</html>
